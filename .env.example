# Copy this file to .env and fill in your own keys.
# .env is gitignored. Never commit real keys.

# --- Required ---------------------------------------------------------------
# ElevenLabs Scribe. Word-level transcription drives the entire pipeline:
# every cut, every motion-graphic beat is timed off these timestamps.
# Get one at https://elevenlabs.io -> Profile -> API Keys
ELEVENLABS_API_KEY=

# --- Optional: b-roll providers (Agent 4 / insert-broll) --------------------
# Without these, insert-broll still works from your local asset-library/,
# it just cannot fetch new stock footage from the web.
# https://www.pexels.com/api/
PEXELS_API_KEY=
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
